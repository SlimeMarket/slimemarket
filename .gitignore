# the App Kit bridge is an esbuild BUNDLE (~2.2 MB + a 12 MB sourcemap).
# It is regenerated by `npm run build:app-kit-bridge` during `npm run build`, so
# committing it only bloats every clone and every diff. It was previously tracked
# while its wallet-bridge sibling was already ignored.
public/app-kit-bridge.js
public/app-kit-bridge.js.map
# Hardhat solc artifact cache — a build artifact, regenerated on `npm run compile`.
cache/
/.playwright-mcp/
/test-results/
/playwright-report/

# task tracker
.zcode-task-tracker/

# session junk
cookies.txt
resp.json
# A real 205-byte file, created when a Git Bash command redirected output to
# `> nul` — MSYS treats it as a filename, not the Windows null device.
#
# ⚠️ It CANNOT be deleted or renamed on Windows: `nul` is a reserved DOS device
# name, so every API resolves it to the null device and refuses. Tried and
# failed: rm (incl. with the safe-delete shim off), mv, cmd del with a \\?\
# path, [System.IO.File]::Delete, FileInfo.Delete ("access denied"), and
# PowerShell Remove-Item. It is ignored here so it can never be committed;
# leave it alone rather than burning time on it.
nul
.zcode-task-tracker/

# large binaries + build outputs (purged from history 2026-08-19 — 300MB)
/bin/
/artifacts/
