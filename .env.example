# =============================================================================
# SlimeMarket — environment template
#
#   cp .env.example .env.local        # local development
#   cp .env.example .env.production   # production server (see README → Deployment)
#
# Every value below is a placeholder. Real values belong in the deployment
# environment (or .env.local, which is gitignored) — never in this file.
# =============================================================================

# ---------------------------------------------------------------------- core
NODE_ENV=development
PORT=3000
# Must equal the origin the app is actually served from, or CSRF checks reject
# every POST with 403.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------ database
# Supabase Postgres. RLS is enabled on every table; the service key is
# server-only and must never reach the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=<anon-key>   # alias accepted by the client
SUPABASE_SECRET_KEY=<service-role-key>                    # SECRET
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>              # alias used by a few paths

# -------------------------------------------------------------------- circle
# Circle Console → Developer Services → Keys
CIRCLE_API_KEY=<api-key>
CIRCLE_ENTITY_SECRET=<64-hex>          # register once: node --import tsx scripts/register-entity.ts
CIRCLE_APP_ID=<ucw-app-id>
NEXT_PUBLIC_CIRCLE_APP_ID=<same-as-above>
CIRCLE_BLOCKCHAIN=ARC-TESTNET          # "ARC" on mainnet
CIRCLE_USDC_TOKEN_ID=<arc-usdc-token-id>
CIRCLE_WALLET_SET_ID=<wallet-set-id>
# Platform relayer wallet (Circle developer-controlled). It pays gas in USDC for
# every settlement — if it is empty, no deal can be released or refunded.
PLATFORM_CIRCLE_WALLET_ID=<platform-wallet-id>
NEXT_PUBLIC_AGENT_WALLET_ID=<same-as-above>
TREASURY_WALLET_ID=<platform-wallet-address>
NEXT_PUBLIC_AGENT_WALLET_ADDRESS=<platform-wallet-address>
NEXT_PUBLIC_CIRCLE_BASE_URL=https://api.circle.com

# ----------------------------------------------------------------------- arc
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002                   # 5042 on mainnet
ARC_EXPLORER_URL=https://testnet.arcscan.app/tx/
ARC_CCTP_DOMAIN=26
CIRCLE_USDC_CONTRACT=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000
# Written by contracts/deploy.ts after a successful deploy.
ESCROW_CONTRACT_ADDRESS=<set-by-deploy>
ESCROW_START_BLOCK=<set-by-deploy>

# ------------------------------------------------------------------- secrets
# Generate each with:  openssl rand -hex 32
VALET_KEK_HEX=<32-byte-hex>            # encrypts the credentials vault — BACK THIS UP
CRON_SECRET=<32-byte-hex>              # shared secret for every scheduled endpoint
INDEXER_CRON_SECRET=<32-byte-hex>
CSRF_SECRET=<32-byte-hex>
RECONCILE_DRIFT_THRESHOLD_MICRO=1000000

# --------------------------------------------------------------------- email
# Transactional mail (order, dispute, invoice, welcome) goes out over the Brevo
# HTTP API on port 443 — SMTP egress is blocked on many hosts.
#
# NOTE: signup/login OTP mail is sent by CIRCLE, not by us. Configure it
# separately in Circle Console → Wallets → User Controlled → Configurator →
# Email, with a template containing {{ email.otp }}.
BREVO_API_KEY=<brevo-api-key>
EMAIL_TRANSPORT=                       # "brevo" | "smtp" | empty = auto-detect
SMTP_FROM=noreply@<your-domain>
# Optional SMTP fallback — only if your host allows SMTP egress.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ---------------------------------------------------------------- rate limit
UPSTASH_REDIS_REST_URL=https://<ref>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>

# ------------------------------------------------------------- observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=info
# Optional Telegram ops alerts
# TG_BOT_TOKEN=
# TG_ADMIN_CHAT_ID=

# ----------------------------------------------------------------- behaviour
# Production MUST use exactly these values — the app refuses to boot otherwise.
CIRCLE_PAYMENTS_MOCK=1                 # 0 in production
FORCE_REAL_UCW=false                   # true in production
ONCHAIN_WALLET_FUNDS=0                 # 1 in production

# Optional: bridge USDC from another chain onto Arc via CCTP. Source-chain gas
# is required — the user's wallet pays for its own approve + burn.
CROSS_CHAIN_PAY=0
# CROSS_CHAIN_SOURCE_CHAINS=baseSepolia,avalancheFuji

# Optional: Cloudflare Turnstile on the OTP request. Off by default; if you
# enable it, BOTH keys are required or every sign-in fails with 403.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Circle webhook source allowlist (empty = disabled).
CIRCLE_WEBHOOK_IPS=
ESCROW_WEBHOOK_IPS=

# ------------------------------------------------------------------- indexer
INDEXER_MAX_BLOCK_SPAN=2000            # Arc's public RPC caps eth_getLogs ranges
INDEXER_CONFIRMATIONS=1

# ------------------------------------------------------------------- gateway
GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
GATEWAY_MINTER_ADDRESS=0x0022222ABE238Cc2C7Bb1f21003F0a260052475B
GATEWAY_API_URL=https://gateway-api-testnet.circle.com/v1

# ------------------------------------------------------------------- app kit
APP_KIT_ENV=production
APP_KIT_API_KEY=<app-kit-key>

# ------------------------------------------------------------------- mainnet
# Switching to Arc mainnet changes these TOGETHER:
#   ARC_CHAIN_ID=5042
#   ARC_RPC_URL=https://rpc.mainnet.arc.io
#   CIRCLE_BLOCKCHAIN=ARC                # not ARC-TESTNET — the SDK rejects it
#   CIRCLE_USDC_TOKEN_ID=<mainnet token id, differs from testnet>
# Then verify before touching real money:
#   node --env-file=.env.mainnet --import tsx scripts/preflight-mainnet.ts
#
# Deploying the contract additionally needs a funded deployer:
# ARC_DEPLOYER_PRIVATE_KEY=<deployer-private-key>
# ARC_DEPLOYER_ADDRESS=<deployer-address>
