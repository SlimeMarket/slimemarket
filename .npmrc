# legacy-peer-deps is DELIBERATE here, not a workaround to be cleaned up.
#
# WHY: `@rainbow-me/rainbowkit` peers on `wagmi@^2.9.0`, but this project runs
# `wagmi@3.7.1`. RainbowKit's newest release (2.2.11) still declares the v2
# range — there is no version that supports wagmi v3, so the conflict cannot be
# resolved by upgrading.
#
# The combination WORKS: both the wallet-bridge and app-kit bundles build and
# run against it today (public/wallet-bridge.js is ~3.8 MB of exactly this
# pairing). What breaks without this flag is only npm's peer VALIDATION.
#
# The concrete failure it prevents: `docker build` ran a bare `npm ci`, which
# re-checks peers, hit ERESOLVE and died at the deps stage — the image could
# never be built, so the app could never be deployed. The lockfile was already
# generated with this behaviour; the Dockerfile simply did not match it.
#
# Set here rather than as a flag in one command so that local installs, CI and
# Docker all resolve identically — otherwise the lockfile drifts again and the
# next `npm ci` fails somewhere new.
#
# ⚠️ If you ever DO move to a RainbowKit release that supports wagmi v3, remove
# this file and re-run `npm install` so the lockfile is regenerated cleanly.
legacy-peer-deps=true
