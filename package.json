{
  "name": "slimemarket-backend",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "setup:env": "node --env-file=.env.local --import tsx scripts/setup-env.ts",
    "repair:middleman": "node --env-file=.env.local --import tsx scripts/repair-middleman.ts",
    "events:gen": "node scripts/gen-escrow-events.mjs",
    "events:verify": "node scripts/verify-escrow-events.mjs",
    "monitors:setup": "node --env-file=.env.local --import tsx scripts/setup-event-monitors.ts",
    "monitors:list": "node --env-file=.env.local --import tsx scripts/setup-event-monitors.ts --list",
    "tunnel": "bash scripts/tunnel.sh",
    "webhook:list": "node scripts/setup-webhook-subscription.mjs --list",
    "webhook:create": "node scripts/setup-webhook-subscription.mjs --create",
    "webhook:verify": "node --env-file=.env.local --import tsx scripts/verify-webhook-e2e.ts",
    "users:cleanup": "node scripts/cleanup-test-users.mjs",
    "db:migrate": "node scripts/migrations.mjs",
    "build:wallet-bridge": "esbuild wallet-bridge/entry.tsx --bundle --outfile=public/wallet-bridge.js --format=iife --jsx=automatic --minify --sourcemap --external:@metamask/connect-evm --external:porto --external:porto/internal --external:@base-org/account --external:@coinbase/wallet-sdk --external:@walletconnect/ethereum-provider --external:@safe-global/safe-apps-provider --external:@safe-global/safe-apps-sdk --define:process.env.NODE_ENV=\\\"production\\\"",
    "build:app-kit-bridge": "esbuild app-kit-bridge/entry.ts --bundle --outfile=public/app-kit-bridge.js --format=iife --target=es2020 --minify --sourcemap --external:@metamask/connect-evm --external:porto --external:porto/internal --external:@base-org/account --external:@coinbase/wallet-sdk --external:@walletconnect/ethereum-provider --external:@safe-global/safe-apps-provider --external:@safe-global/safe-apps-sdk --define:process.env.NODE_ENV=\\\"production\\\"",
    "build": "npm run build:wallet-bridge && npm run build:app-kit-bridge && next build",
    "prebuild": "npm run clean",
    "clean": "rm -rf .next && rm -rf temp_build_cache",
    "start": "next start",
    "build:analyze": "BUNDLE_ANALYZE=true next build",
    "build:stats": "webpack-bundle-analyzer .next/stats.json public/stats-report.html",
    "analyze": "npm run build:analyze",
    "build:optimize": "next build && npm run analyze",
    "cron": "node scripts/scheduler.js",
    "lint": "eslint .",
    "lint:fe": "node scripts/check-fe-syntax.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:contracts",
    "smoke:local": "node scripts/smoke-local.mjs",
    "check:cuid": "node scripts/tools/cuid-check.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "compile": "hardhat compile",
    "test:contracts": "hardhat test",
    "test:onchain": "node --env-file=.env.local --import tsx scripts/e2e-escrow-testnet.ts",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "size-check": "du -sh .next/static/chunks/* | sort -hr | head -10",
    "bundle:report": "npm run build && npx webpack-bundle-analyzer .next/stats.json ./bundle-report.html",
    "cleanup": "node scripts/cleanup-dependencies.js",
    "deps:prune": "npm prune",
    "security:sweep": "bash scripts/tools/security-sweep.sh",
    "ui:smoke": "node scripts/ui-smoke.mjs",
    "ui:interact": "node scripts/ui-interact.mjs",
    "ui:buy": "node scripts/ui-buy-flow.mjs",
    "test:unit": "vitest run",
    "test:all": "npm run test:unit && npm run test:contracts && npm run security:sweep",
    "ui:roles": "node scripts/ui-roles.mjs"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.18.0",
    "@circle-fin/app-kit": "^1.15.2",
    "@circle-fin/bridge-kit": "^1.15.1",
    "@circle-fin/onramp-kit": "^1.0.1",
    "@circle-fin/smart-contract-platform": "^10.8.0",
    "@circle-fin/swap-kit": "^1.7.0",
    "@circle-fin/user-controlled-wallets": "^10.8.0",
    "@circle-fin/w3s-pw-web-sdk": "^1.0.13",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@sentry/nextjs": "^10.66.0",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@tanstack/react-query": "^5.101.2",
    "@types/sanitize-html": "^2.16.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "next": "^15.5.23",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.6",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.55.0",
    "wagmi": "^3.7.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@eslint/eslintrc": "^3",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/contracts": "^5.6.1",
    "@playwright/test": "^1.62.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "chai": "^4.4.1",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.0",
    "hardhat-gas-reporter": "^1.0.10",
    "pino-pretty": "^13.1.3",
    "solc": "^0.8.24",
    "solidity-coverage": "^0.8.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typechain": "^8.3.2",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "webpack-bundle-analyzer": "^4.10.1"
  },
  "type": "module"
}
